{
  "name": "collab-board",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run db:migrate && vite",
    "build": "vite build",
    "preview": "vite preview",
    "db:migrate": "wrangler d1 migrations apply finjan --local",
    "deploy": "npm run build && wrangler d1 migrations apply finjan --remote && wrangler deploy",
    "typecheck": "tsc -p tsconfig.web.json && tsc -p tsconfig.worker.json",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "test:ui": "node test-ui/smoke.mjs",
    "dev:ai": "AI_REMOTE=1 npm run dev",
    "dev:phone": "npm run dev -- --host"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@tanstack/react-query": "5.105.0",
    "hono": "4.13.16",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.66.0",
    "@cloudflare/vitest-plugin": "1.4.11",
    "@cloudflare/workers-types": "5.20261101.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.14.0",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.156.0"
  }
}
